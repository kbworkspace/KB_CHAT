# Frontend environment (copy to .env.local; never commit real values).

# Google sign-in (public client id; ships in the bundle).
VITE_GOOGLE_CLIENT_ID=

# Sentry error reporting. Empty = disabled. The DSN is public by design;
# traces stay off (0) because they cost quota.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_APP_VERSION=1.2.2
